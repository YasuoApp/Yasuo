# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
dist
dist-electron
dist-web
dist-renderer
release

# Generated from resources/icon-source.png and by scripts/dmg-background.mjs.
# The source art is committed; what is derived from it is not.
resources/background.png
resources/background@2x.png

# local bun cache/tmp overrides
.bun-cache
.bun-tmp

# misc
.DS_Store
*.pem

# scratch files: a repro, a one-off preview, a snippet kept beside the code it
# is about. The suffix is the marker, so they can live next to their subject
# without being committed.
*.local.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

