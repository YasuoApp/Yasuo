rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Already in the project before the account's workspace; kept so deploying
    // this file does not drop it.
    match /projects/{documentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // One document per signed-in account, at `workspaces/<uid>`, holding that
    // account's folder list and synced settings — see src/renderer/lib/cloud-workspace.ts.
    // An account reads and writes its own document and no other.
    match /workspaces/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.keys().hasOnly(
          ['ownerUid', 'name', 'folders', 'settings', 'updatedAt']
        );
    }
  }
}
