# Prettier decides formatting for the files it owns; this is for the editors
# and the files it does not — Makefile, YAML, the odd .md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

[Makefile]
indent_style = tab

[*.md]
# A hard-wrapped line and a trailing double space are both meaningful here.
trim_trailing_whitespace = false
